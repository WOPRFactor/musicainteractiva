# ============================================================================
# EMION · Backend — variables de entorno
# Copiá como .env y ajustá. Estos valores por defecto sirven para correr
# LOCAL / en una VM (Postgres y Redis en localhost).
# En Docker, docker-compose ya inyecta las suyas (host = db / redis).
# ============================================================================

FLASK_CONFIG=development
HOST=0.0.0.0
PORT=5000

# Secretos (cambialos en producción)
SECRET_KEY=dev-secret-cambiar
JWT_SECRET_KEY=dev-jwt-secret-cambiar

# --- Base de datos (local / VM) ---
DATABASE_URL=postgresql+psycopg2://emion:emion@localhost:5432/emion

# --- Redis (local / VM) ---
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# --- Auth / cookies ---
# En producción con HTTPS poné JWT_COOKIE_SECURE=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true

# --- CORS: orígenes del frontend permitidos (separados por coma) ---
CORS_ORIGINS=http://localhost:3000
